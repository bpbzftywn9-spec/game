# server/.env にコピーして値を入れる（.env はコミットしない）

# 公開URL（Stripeの戻り先に使う。末尾の / なし）
PUBLIC_URL=https://example.com
PORT=8787

# mock = テスト決済（請求なし）／ stripe = Stripe で本物の決済
PAYMENT_MODE=mock
# 本番では必ず設定（mock が使えなくなる）
# NODE_ENV=production

# Stripe ダッシュボード → 開発者 → APIキー（最初は sk_test_ で試す）
STRIPE_SECRET_KEY=
# Stripe ダッシュボード → 開発者 → Webhook（送信先: PUBLIC_URL/api/stripe/webhook）
# イベント: checkout.session.completed / checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# 1アカウントの月間購入上限（円）。未成年の高額課金対策
MONTHLY_LIMIT_JPY=10000

# SQLite の保存先（サーバーを再起動しても消えないディスクに置く）
DB_PATH=./data/game.db

# リバースプロキシ（Render / Fly.io など）の後ろで動かす場合は 1
TRUST_PROXY=1

# 特定商取引法に基づく表記に出す販売者情報（SELLER_NAME と SELLER_EMAIL が空のあいだは販売停止）
SELLER_NAME=
SELLER_EMAIL=
SELLER_REPRESENTATIVE=
# 空にすると「請求があった場合には遅滞なく開示します」と表示
SELLER_ADDRESS=
SELLER_PHONE=
LEGAL_EFFECTIVE_DATE=
LEGAL_COURT=

# Stripe の詳細設定（通常は変更不要）
# API バージョン固定。上げるときは Stripe の変更履歴を確認してから
STRIPE_API_VERSION=2026-11-18.endive
# 商品の税コード（Managed Payments / Stripe Tax で必須）。既定: ブラウザゲームの消費型アイテム
STRIPE_TAX_CODE=txcd_10201003
# off にすると Managed Payments（Stripe が販売者として税務を代行）を使わない
STRIPE_MANAGED_PAYMENTS=default

# 1 にすると、DB_PATH のフォルダに消えないディスクが付いていない間は販売しない（Render では render.yaml で設定済み）
REQUIRE_PERSISTENT_DISK=
